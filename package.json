{
  "name": "x2f",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "audit": "npm audit --omit=dev",
    "semgrep": "~/.local/semgrep-venv/bin/semgrep scan --config p/typescript --config p/nodejs --config p/secrets --error --metrics=off packages apps tools",
    "check": "bash tools/check.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "uuid": "11.1.1",
    "fastify-plugin": "6.0.0"
  }
}
